# LLM API Keys (Provide at least one to enable live LLM evaluation; otherwise system runs in dynamic offline fallback mode)
# Option 1: Google Gemini (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Option 2: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option 3: Groq (Ultra-fast free inference at https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

